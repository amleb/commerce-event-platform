{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@commerce-event-platform/shared-kernel": ["packages/shared-kernel/src"],
      "@commerce-event-platform/config": ["packages/config/src"],
      "@commerce-event-platform/logger": ["packages/logger/src"],
      "@commerce-event-platform/testing": ["packages/testing/src"]
    }
  }
}
